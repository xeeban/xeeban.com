---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Now - Nori Nishigaya">
  <div class="max-w-4xl mx-auto">
    <div class="mb-8">
      <h1 class="text-4xl font-bold text-gray-900 dark:text-white mb-4">What I'm Doing Now</h1>
      <p class="text-gray-600 dark:text-gray-400">
        Last updated: {new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
      </p>
    </div>

    <div class="prose dark:prose-invert max-w-none">
      <!-- Current Focus -->
      <section class="mb-12">
        <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-6">Current Focus</h2>
        <div class="space-y-6">
          <div class="bg-blue-50 dark:bg-blue-900/20 rounded-lg p-6 border border-blue-200 dark:border-blue-800">
            <h3 class="text-2xl font-semibold text-gray-900 dark:text-white mb-3">100 Days of AI</h3>
            <p class="text-gray-700 dark:text-gray-300 mb-2">
              Starting September 15, 2025, I'm embarking on a structured exploration of AI technologies.
              This journey is about understanding how we can leverage AI while preserving what makes us uniquely human.
            </p>
            <p class="text-sm text-gray-600 dark:text-gray-400 mt-2">
              Following along on Twitter and documenting insights along the way.
            </p>
          </div>
        </div>
      </section>

      <!-- Work & Projects -->
      <section class="mb-12">
        <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-6">Work & Projects</h2>
        <div class="space-y-6">
          <div class="bg-white dark:bg-gray-800 rounded-lg p-6 border border-gray-200 dark:border-gray-700">
            <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-2">Andamio - Trust Protocol</h3>
            <p class="text-gray-700 dark:text-gray-300">
              Co-founding and building infrastructure for decentralized collaboration and learning.
              Creating systems that enable high-trust interactions in distributed environments.
            </p>
          </div>
          <div class="bg-white dark:bg-gray-800 rounded-lg p-6 border border-gray-200 dark:border-gray-700">
            <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-2">ODIN Network</h3>
            <p class="text-gray-700 dark:text-gray-300">
              Supporting decentralized innovation networks with a focus on bio-regional revitalization
              and self-managed organizational principles.
            </p>
          </div>
        </div>
      </section>

      <!-- Learning -->
      <section class="mb-12">
        <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-6">Learning</h2>
        <div class="grid gap-4 sm:grid-cols-2">
          <div class="bg-gray-50 dark:bg-gray-800 rounded-lg p-4 border border-gray-200 dark:border-gray-700">
            <h4 class="font-semibold text-gray-900 dark:text-white mb-2">日本語 (Japanese)</h4>
            <p class="text-sm text-gray-700 dark:text-gray-300">Continuing language study</p>
          </div>
          <div class="bg-gray-50 dark:bg-gray-800 rounded-lg p-4 border border-gray-200 dark:border-gray-700">
            <h4 class="font-semibold text-gray-900 dark:text-white mb-2">Personal Knowledge Management</h4>
            <p class="text-sm text-gray-700 dark:text-gray-300">Zettelkasten methods and networked thinking</p>
          </div>
          <div class="bg-gray-50 dark:bg-gray-800 rounded-lg p-4 border border-gray-200 dark:border-gray-700">
            <h4 class="font-semibold text-gray-900 dark:text-white mb-2">UX Design</h4>
            <p class="text-sm text-gray-700 dark:text-gray-300">Exploring user experience principles</p>
          </div>
          <div class="bg-gray-50 dark:bg-gray-800 rounded-lg p-4 border border-gray-200 dark:border-gray-700">
            <h4 class="font-semibold text-gray-900 dark:text-white mb-2">Collective Intelligence</h4>
            <p class="text-sm text-gray-700 dark:text-gray-300">Networkiness and sense-making</p>
          </div>
        </div>
      </section>

      <!-- Practice & Philosophy -->
      <section class="mb-12">
        <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-6">Practice & Philosophy</h2>
        <div class="bg-gradient-to-r from-purple-50 to-pink-50 dark:from-gray-800 dark:to-gray-700 rounded-lg p-6 border border-purple-200 dark:border-gray-600">
          <p class="text-gray-700 dark:text-gray-300 mb-4">
            Continuing Zen Buddhist practice, exploring how contemplative traditions inform
            approaches to technology, governance, and organizational design.
          </p>
          <p class="text-gray-700 dark:text-gray-300">
            Currently investigating the intersection of integral theory, evolutionary organizational
            principles, and decentralized systems.
          </p>
        </div>
      </section>

      <!-- About This Page -->
      <section>
        <div class="text-sm text-gray-600 dark:text-gray-400 border-t border-gray-200 dark:border-gray-700 pt-6">
          <p>
            This is a <a href="https://nownownow.com/about" target="_blank" rel="noopener noreferrer"
            class="text-blue-600 dark:text-blue-400 hover:underline">"now page"</a>,
            inspired by Derek Sivers. It's a way to share what I'm focused on at this point in my life.
          </p>
        </div>
      </section>
    </div>
  </div>
</Layout>
